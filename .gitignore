# Environment and secrets
.env
.env.*
!.env.example

# Local runtime config. The *.example.yaml files are the committed templates; a real
# config carries account handles and collection ids and must never be committed.
config/*.yaml
!config/*.example.yaml
*.pem
*.key

# Runtime data
var/
data/*.db
data/*.sqlite*
*.sqlite*
*.db
browser-profiles/
media-cache/
model-cache/
repo-cache/
debug/
logs/

# Node / Python
node_modules/
.next/
.next-e2e/
.next-remote/
.next-remote-e2e/
dist/
build/
target/
apps/desktop/src-tauri/gen/schemas/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.pnpm-store/
*.tsbuildinfo
next-env.d.ts

# Test and build output
coverage/
.turbo/
playwright-report/
test-results/
__screenshots__/
*.local

# macOS / editors
.DS_Store
.vscode/settings.json
.idea/

# User/session artifacts
*.har
*cookies*.json
*storage-state*.json
*auth-state*.json

# Documentation. The published repository carries only what someone needs to *run* this:
# README, plus BOOTSTRAP (install), FEASIBILITY (what this host actually verified),
# SECURITY_BOUNDARIES (read before letting an agent run on your machine) and
# SYSTEM_ARCHITECTURE (what connects to what). Design specs and the decision log are for
# continuing development, not for using the product, and stay on the machine.
docs/*
!docs/BOOTSTRAP.md
!docs/FEASIBILITY.md
!docs/SECURITY_BOUNDARIES.md
!docs/SYSTEM_ARCHITECTURE.md

# Agent working instructions. Local only.
/CLAUDE.md
apps/web/CLAUDE.md
apps/web/AGENTS.md
