# Never commit real values.
APP_ENV=development
APP_TIMEZONE=Asia/Seoul
DATABASE_URL=sqlite:///./var/data/taste-inbox.db

# Frontend (apps/web). Mock mode requires no secrets at all.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DATA_SOURCE=mock
API_BASE_URL=http://127.0.0.1:8787

# Backend (apps/api). Optional runtime config paths.
TASTE_INBOX_APP_CONFIG=./config/app.yaml
TASTE_INBOX_RESOURCE_POLICY_CONFIG=./config/resource-policy.yaml
TASTE_INBOX_HOST_PROFILE_FIXTURE=
GITHUB_TOKEN=
LLM_API_KEY=
VISION_API_KEY=
SEARCH_API_KEY=
NOTIFICATION_WEBHOOK_URL=
