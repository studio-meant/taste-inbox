# Never commit real values.
APP_ENV=development
APP_TIMEZONE=Asia/Seoul
DATABASE_URL=sqlite:///./var/data/taste-inbox.db

# Frontend (apps/web). Mock mode requires no secrets at all.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DATA_SOURCE=mock
API_BASE_URL=http://127.0.0.1:8787

# Backend (apps/api). Optional runtime config paths.
TASTE_INBOX_APP_CONFIG=./config/app.yaml
TASTE_INBOX_RESOURCE_POLICY_CONFIG=./config/resource-policy.yaml
TASTE_INBOX_HOST_PROFILE_FIXTURE=
GITHUB_TOKEN=
LLM_API_KEY=
VISION_API_KEY=
SEARCH_API_KEY=
NOTIFICATION_WEBHOOK_URL=

# --- API collectors (2026-09-28) ---
# GitHub Stars API. Required: /user/starred needs a token to know whose stars to read.
# A fine-grained token with read-only "Starring" is enough.
GITHUB_LOGIN=
# Hugging Face likes (models · datasets · Spaces). The token is optional for public likes.
HF_USERNAME=
HF_TOKEN=

# --- NVIDIA R&D ---
# Where research questions go. There is no default: an unset value refuses to send.
# Local-first — run AI-Q on this machine, bound to loopback:
#   ./scripts/start_as_skill.sh --host 127.0.0.1 --port 8010 …
# (its own default host is 0.0.0.0; do not use it). A non-local URL must be https.
AIQ_SERVER_URL=http://127.0.0.1:8010
# The OpenShell sandbox trials run in (`nemoclaw onboard`, no --host-mount).
NEMOCLAW_SANDBOX_NAME=taste-inbox
# Read by the AI-Q backend process and, since 2026-09-28, by this repository's API for
# the Nemotron calls below. Host-side either way: never passed into the sandbox, never
# sent to the browser.
NVIDIA_API_KEY=
# Nemotron through the hosted NIM endpoint, for the suggested questions and the reading of
# a finished trial (`research/nim.py`). Both have working defaults — the endpoint NVIDIA
# publishes for prototyping, and the model measured fastest on this host — so these two are
# only for pointing at a different catalog or a self-hosted NIM.
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_MODEL=
TAVILY_API_KEY=
